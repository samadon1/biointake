# Copy to .env (gitignored) and fill in. Never commit the real file.

# Which token generator the agent runs on.
#
#   offline             a deterministic stand-in. No key, no network, no cost. The Strands event
#                       loop, the eleven tools, the hooks, the interventions and the policy engine
#                       are all the real ones; only the model is substituted. This is the default
#                       so a fresh clone can run `make check` without credentials.
#   anthropic:<model>   the Anthropic API, keyed below or from ANTHROPIC_API_KEY_PARAMETER
#   <bedrock-model-id>  Amazon Bedrock, using ambient AWS credentials
#
# The deployed service runs a live model, not this default. docs/phase2b-results.md has three live
# runs and what held across all of them.
BIOINTAKE_MODEL_ID=offline

ANTHROPIC_API_KEY=
